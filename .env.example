# Copy to .env and adjust as needed
AUROELIC_HOST=127.0.0.1
AUROELIC_PORT=8000
# Leave empty to disable authentication (only safe on localhost). Set to a long random string for remote access.
AUROELIC_TOKEN=
# Sampling interval (seconds, 1-60)
AUROELIC_INTERVAL=2
# History retention (hours)
AUROELIC_RETENTION_HOURS=24
AUROELIC_DB_PATH=auroelic.db
AUROELIC_MAX_WS=50
