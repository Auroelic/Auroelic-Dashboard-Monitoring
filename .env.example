# Salin menjadi .env lalu sesuaikan
AUROELIC_HOST=127.0.0.1
AUROELIC_PORT=8000
# Kosongkan untuk menonaktifkan autentikasi (hanya aman di localhost). Isi dengan string acak panjang untuk akses jarak jauh.
AUROELIC_TOKEN=
# Interval pengambilan sampel (detik, 1-60)
AUROELIC_INTERVAL=2
# Lama penyimpanan riwayat (jam)
AUROELIC_RETENTION_HOURS=24
AUROELIC_DB_PATH=auroelic.db
AUROELIC_MAX_WS=50
